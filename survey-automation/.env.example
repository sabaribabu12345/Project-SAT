# Control plane
CONTROL_PLANE_DATABASE_URL=sqlite:///./data/control_plane.db

# Databricks (required for Slice 0 integration check)
DATABRICKS_HOST=https://adb-<workspace-id>.<region>.azuredatabricks.net

# Preferred: OAuth machine-to-machine (service principal)
DATABRICKS_AUTH_TYPE=oauth-m2m
DATABRICKS_CLIENT_ID=<databricks-client-id>
DATABRICKS_CLIENT_SECRET=<databricks-client-secret>

# Optional PAT fallback (leave empty when using oauth-m2m)
# DATABRICKS_TOKEN=<databricks-token>

# Databricks SQL resolver (required for production field resolution)
DATABRICKS_SQL_WAREHOUSE_ID=<sql-warehouse-id>
DATABRICKS_SQL_WAIT_TIMEOUT=30s
DATABRICKS_SQL_POLL_TIMEOUT_SECONDS=120
# auto = use SQL when warehouse is configured, otherwise local fake-form values
# sql = require Databricks SQL for non-literal values
# fake = force local fake-form values
DATABRICKS_RESOLVER_MODE=auto
# Optional: Genie API support for draft mapping suggestions
# Requires space-level Genie permissions and a Databricks bearer token from
# DATABRICKS_TOKEN or OPENAI_API_KEY, or OAuth M2M via
# DATABRICKS_CLIENT_ID + DATABRICKS_CLIENT_SECRET.
# DATABRICKS_GENIE_SPACE_ID=<genie-space-id>
# DATABRICKS_GENIE_POLL_TIMEOUT_SECONDS=45
# DATABRICKS_GENIE_POLL_INTERVAL_SECONDS=2
# DATABRICKS_GENIE_REQUEST_TIMEOUT_SECONDS=30
# DATABRICKS_GENIE_BATCH_SIZE=50
# DATABRICKS_GENIE_MAX_PROMPT_CHARS=23000
# DATABRICKS_GENIE_OPTIONS_PER_CANDIDATE=5

# Skyvern -> Databricks model routing
ENABLE_OPENAI=true
# For Skyvern OpenAI-compatible calls, set a short-lived Databricks access token.
# Generate with:
#   python infra/scripts/print_model_serving_token.py
OPENAI_API_KEY=<databricks-oauth-access-token>
OPENAI_API_BASE=https://<workspace-host>/serving-endpoints
# Must match a Databricks Serving endpoint name exactly.
# Recommended default for this project:
OPENAI_DEFAULT_MODEL=databricks-claude-sonnet-4-6
# Skyvern custom model routing (OpenAI-compatible)
ENABLE_OPENAI_COMPATIBLE=true
OPENAI_COMPATIBLE_MODEL_KEY=DATABRICKS_CLAUDE_SONNET_46
OPENAI_COMPATIBLE_MODEL_NAME=databricks-claude-sonnet-4-6
OPENAI_COMPATIBLE_API_BASE=https://<workspace-host>/serving-endpoints
# Optional: if unset, compose startup derives it from OPENAI_API_KEY.
# OPENAI_COMPATIBLE_API_KEY=<databricks-oauth-access-token>
LLM_KEY=DATABRICKS_CLAUDE_SONNET_46

# Optional: PDF candidate mapping with text embeddings (hybrid with token scoring)
# Keep disabled by default until you validate mapping quality on your survey set.
PDF_EMBEDDING_MAPPING_ENABLED=false
PDF_EMBEDDING_MODEL=text-embedding-3-small
# If unset, falls back to OPENAI_API_BASE.
# PDF_EMBEDDING_API_BASE=https://<workspace-host>/serving-endpoints
# If unset, falls back to OPENAI_API_KEY.
# PDF_EMBEDDING_API_KEY=<databricks-oauth-access-token>
PDF_EMBEDDING_TIMEOUT_SECONDS=20

# PDF scan enrichment always uses OpenAI Responses API with the full PDF.
# How many discovered PDF candidates to include in the OpenAI PDF scan request (0 disables label enrichment calls).
PDF_LABEL_ENRICHMENT_CANDIDATE_LIMIT=250

# OpenAI PDF scan config.
# Use a real OpenAI API key here; do not reuse the Databricks OAuth token above.
PDF_OPENAI_LABEL_ENRICHMENT_ENABLED=true
PDF_OPENAI_LABEL_ENRICHMENT_MODEL=gpt-4o-mini
PDF_OPENAI_LABEL_ENRICHMENT_API_BASE=https://api.openai.com/v1
# PDF_OPENAI_LABEL_ENRICHMENT_API_KEY=<openai-api-key>
# Used only by the legacy candidate-snippet fallback path.
PDF_OPENAI_LABEL_ENRICHMENT_BATCH_SIZE=25
PDF_OPENAI_LABEL_ENRICHMENT_TIMEOUT_SECONDS=180
PDF_OPENAI_PAGES_PER_BATCH=5
PDF_OPENAI_MAX_CONCURRENT_BATCHES=5
PDF_OPENAI_MAX_FIELDS_PER_BATCH=30

# Databricks model serving is still available for experimental direct label calls, but scan_pdf does not use it.
# Must be an existing serving endpoint name.
# Example: databricks-claude-sonnet-4-6
# PDF_DATABRICKS_LABEL_MODEL=databricks-claude-sonnet-4-6
PDF_DATABRICKS_LABEL_BATCH_SIZE=100
PDF_DATABRICKS_LABEL_MAX_PROMPT_CHARS=18000
PDF_DATABRICKS_LABEL_TIMEOUT_SECONDS=45

# Skyvern API auth
SKYVERN_API_KEY=<set-a-local-dev-key>
SKYVERN_BASE_URL=http://localhost:8000
CONTROL_PLANE_PUBLIC_BASE_URL=http://localhost:8010
# Optional: if set, webhooks must include X-Skyvern-Signature=HMAC_SHA256(body)
SKYVERN_WEBHOOK_SECRET=
TEMPORAL_TARGET_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_SIGNAL_ENABLED=false
SKYVERN_MAX_FIELDS_PER_TASK=8
SKYVERN_TASK_COMPLEXITY_BUDGET_CHARS=1400
SKYVERN_VALIDATE_MAX_STEPS=25
SKYVERN_SCAN_MAX_STEPS=35
SKYVERN_FILL_MAX_STEPS=45

# Browser/CDP mode (for connecting Skyvern to your local browser)
# For local Edge/Chrome CDP on macOS/Windows:
BROWSER_TYPE=cdp-connect
BROWSER_REMOTE_DEBUGGING_URL=http://host.docker.internal:9222/
BROWSER_TIMEZONE=America/Los_Angeles
BROWSER_LOCALE=en-US

# Allow local/private test hosts in self-hosted mode
ALLOWED_HOSTS=["localhost","127.0.0.1"]
